{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": ["**", "!dist", "!test/.tmp", "!**/drizzle/meta"]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"javascript": {
		"formatter": { "quoteStyle": "single" }
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"style": { "noNonNullAssertion": "error" }
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
